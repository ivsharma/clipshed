{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Clipshed",
  "version": "1.1.0",
  "identifier": "com.clipshed.app",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://127.0.0.1:43123",
    "beforeDevCommand": "npm run build -w web",
    "beforeBuildCommand": "npm run build -w web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipshed",
        "width": 1320,
        "height": 920,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "http://127.0.0.1:43123"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
