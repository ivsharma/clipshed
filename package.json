{
  "name": "clipshed",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first video range clipper: fetch only the section you need as MP4, MP3, or both.",
  "author": "Clipshed",
  "license": "MIT",
  "keywords": [
    "youtube",
    "youtube-downloader",
    "video-clipper",
    "time-range",
    "yt-dlp",
    "ffmpeg",
    "local-first",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-binaries.ps1",
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.app.json --noEmit",
    "version:check": "node scripts/check-version.mjs",
    "desktop:verify": "node scripts/check-desktop.mjs",
    "desktop:server": "node scripts/build-desktop.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:stage": "node scripts/stage-tauri-windows.mjs",
    "tauri:windows:dev": "npm run build -w web && npm run desktop:server && npm run tauri:stage && tauri dev --no-watch --no-dev-server-wait",
    "tauri:windows:build": "npm run build -w web && npm run desktop:server && npm run tauri:stage && tauri build",
    "tauri:android:init": "tauri android init",
    "tauri:android:build": "tauri android build --apk",
    "tauri:android:debug": "tauri android build --debug --apk",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
